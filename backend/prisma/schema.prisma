// ─── Application (clientes OAuth2/OIDC) ─────────────────
model Application {
  id                  String   @id @default(cuid())
  name                String
  subtitle            String
  icon                String
  iconColor           String   @default("primary")
  clientId            String   @unique
  type                String   // 'spa' | 'web' | 'm2m' | 'native'
  status              String   @default("active")   // 'active' | 'staging' | 'disabled'
  statusLabel         String
  domainLabel         String
  domainValue         String
  domainIcon          String   @default("lock")
  metricLabel         String
  metricValue         String
  metricSecondary     String?
  metricSecondaryIcon String?
  organizationId      String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]

  @@index([organizationId])
  @@index([type])
}

// ─── API Key (credenciales M2M) ─────────────────────────
model ApiKey {
  id             String    @id @default(cuid())
  serviceName    String
  serviceId      String    @unique
  icon           String    @default("vpn_key")
  iconColor      String    @default("primary")
  keyPrefix      String
  keyHash        String    // SHA-256 del valor completo (NUNCA guardes el plaintext)
  environment    String    // 'production' | 'staging'
  scopes         String[]
  lastUsedAt     DateTime?
  lastUsedIp     String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  organizationId String
  applicationId  String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application  Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([environment])
}

// ─── Audit Log (eventos inmutables) ─────────────────────
model AuditLog {
  id               String   @id @default(cuid())
  timestamp        DateTime @default(now())
  severity         String   // 'critical' | 'warning' | 'info'
  eventType        String   // 'anomaly.ip_blocked', 'login.success', etc.

  actorType        String   // 'system_agent' | 'user' | 'service' | 'root'
  actorName        String
  actorSubLabel    String
  actorInitials    String
  actorInitialsBg  String
  actorIsError     Boolean  @default(false)

  geoCity          String?
  geoCountry       String?
  geoFlag          String?
  geoNetworkType   String?
  geoIsError       Boolean  @default(false)

  targetPrimary    String
  targetSecondary  String?
  targetIsError    Boolean  @default(false)

  status           String   // 'success' | 'failed' | 'blocked'
  statusLabel      String
  statusIcon       String

  detail           Json?    // merkle, hashes, ja3, raw JSON, etc.

  organizationId   String
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, timestamp])
  @@index([severity])
  @@index([eventType])
}